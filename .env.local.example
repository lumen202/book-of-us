# Copy this file to .env.local and fill in values from your Supabase project
# settings (Project Settings -> API). Never commit .env.local — it's already
# in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only. Used by lib/supabase/admin.ts (permanent
# deletes, gated on requireAdmin()) and scripts/seed-demo.ts. Never reference
# this in app/ or lib/ code that runs in a request path for a signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/create-chapter on the 1st of each month (see vercel.json).
# Any random string; set the same value in the Vercel project's env vars.
CRON_SECRET=

# Optional, dev-only: pre-fills the login page's "Autofill test account"
# button (that button only renders when NODE_ENV=development). Update
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD here whenever you change the real password
# through Keeper -> Passwords, instead of editing login/page.tsx.
NEXT_PUBLIC_DEV_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# The demo account (docs/agent/codebase-map/demo.md) — same Supabase project
# as the real account, isolated by a separate Postgres schema (`demo`) and
# separate storage buckets (demo-memories/demo-vault) rather than a second
# project. Visiting /demo signs in automatically with these credentials and
# every request in that session opens with db.schema: "demo", so it can never
# reach the real (`public`) data. Leave both blank to disable the demo
# entirely (/demo returns 503 rather than erroring).
#
# Server-only — never reference these outside app/(auth)/demo/route.ts.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
