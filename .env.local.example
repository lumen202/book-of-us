# Copy this file to .env.local and fill in values from your Supabase project
# settings (Project Settings -> API). Never commit .env.local — it's already
# in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, used exclusively by scripts/backup-export.ts.
# Never reference this in app/ or lib/ code that runs in a request path.
SUPABASE_SERVICE_ROLE_KEY=
